{
	// Declaration emit against the published declarations: a module that returns pomwright's builders, seeds and
	// every public member without annotations must emit (declaration: true reports TS4023, TS4094 or TS2883 for a
	// type a consumer cannot name). Run by pnpm typecheck and pack-test.sh.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"noEmit": true
	},
	"files": ["tests/packaging/publicTypes.emit.ts"]
}
