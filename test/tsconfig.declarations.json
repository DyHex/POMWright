{
	// Declaration emit against the published declarations: modules that return pomwright's values without annotations
	// must emit (declaration: true reports TS4023, TS4094 or TS2883 for a type a consumer cannot name). By hand,
	// tests/packaging/publicTypes.emit.ts: the builders' chains, the seeds and the forms a project writes; generated by
	// scripts/generate-emit-members.mjs from tests/packaging/emitSeeds.ts, .emit-members/members.ts: every public member
	// of every export, and the page objects' protected ones. Run by pnpm typecheck and pack-test.sh, after the generator.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"noEmit": true
	},
	"files": ["tests/packaging/publicTypes.emit.ts", ".emit-members/members.ts"]
}
