# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
.pnpm-store/
jspm_packages/
test/node_modules/

# Playwright integration test outputs
test/playwright-report/
test/test-results/
test/blob-report/
test/playwright/.cache/

# The documentation's TypeScript examples, and the doc comments', extracted and compiled by scripts/check-doc-snippets.mjs
test/.doc-snippets/
test/.doc-examples/

# @step's legacy decorators as tsc emits them (test/tsconfig.legacyDecorators.emit.json), run by test/step-locations
test/.legacy-decorators/
# every public member, generated from the published declarations for the declaration-emit check
test/.emit-members/

# Astro's generated types of the documentation site (website/dist is ignored by the dist rule)
website/.astro/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz
pomwright-test-build.tgz

# Extracted package the harness in test/ installs (pack-build.sh, pack-extract.sh)
.pack/

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
