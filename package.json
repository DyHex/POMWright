{
	"name": "pomwright",
	"version": "2.1.0",
	"description": "POMWright is a complementary test framework for Playwright written in TypeScript.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DyHex/POMWright.git"
	},
	"homepage": "https://github.com/DyHex/POMWright#readme",
	"bugs": {
		"url": "https://github.com/DyHex/POMWright/issues"
	},
	"author": {
		"name": "Magnus Blütecher Dysthe"
	},
	"license": "Apache-2.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup index.ts --format cjs --dts && node scripts/write-esm-entry.mjs",
		"release": "pnpm run build && changeset publish",
		"lint": "biome check --error-on-warnings .",
		"format": "biome format --write .",
		"harness:install": "bash pack-build.sh && pnpm -C test install --frozen-lockfile",
		"typecheck": "tsc --noEmit -p test && tsc -p test/tsconfig.declarations.json && node scripts/check-doc-snippets.mjs",
		"pack-test": "bash pack-test.sh",
		"test:unit": "vitest run",
		"test": "pnpm test:unit && pnpm pack-test"
	},
	"keywords": [
		"Playwright",
		"POM",
		"Page Object Model",
		"Locator",
		"Chaining",
		"Nesting",
		"LocatorSchema",
		"SessionStorage",
		"Test",
		"Test Framework",
		"E2E",
		"End-to-End Testing",
		"Automation",
		"Browser Automation",
		"Web Testing",
		"Logging",
		"Log Levels",
		"TypeScript"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@playwright/test": "1.64.0",
		"@types/node": "^24.5.2",
		"tsup": "^8.5.0",
		"typescript": "^5.9.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.64.0 <2.0.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@9.12.0"
}
