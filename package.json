{
	"name": "pomwright",
	"version": "3.0.1",
	"description": "A TypeScript library for Playwright Test that organises a suite's locators and page objects.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DyHex/POMWright.git"
	},
	"homepage": "https://dyhex.github.io/POMWright/",
	"bugs": {
		"url": "https://github.com/DyHex/POMWright/issues"
	},
	"author": {
		"name": "Magnus Tømte Dysthe"
	},
	"license": "Apache-2.0",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/**",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsup index.ts --format cjs --dts --clean && node scripts/write-esm-entry.mjs",
		"release": "pnpm run build && changeset publish",
		"lint": "biome check --error-on-warnings .",
		"format": "biome format --write .",
		"harness:install": "bash pack-build.sh && pnpm -C test install --frozen-lockfile",
		"typecheck": "tsc --noEmit -p test && tsc -p test/tsconfig.declarations.json && tsc -p test/tsconfig.legacyDecorators.json && tsc -p test/tsconfig.legacyDecorators.emit.json && node scripts/check-doc-snippets.mjs && node scripts/check-api-coverage.mjs && node scripts/check-error-messages.mjs",
		"pack-test": "bash pack-test.sh",
		"pack:version": "bash scripts/pack-version.sh",
		"test:unit": "vitest run",
		"bench": "node --expose-gc --max-old-space-size=8192 scripts/benchmark.mjs",
		"test": "pnpm test:unit && pnpm pack-test",
		"docs:dev": "pnpm -C website install --frozen-lockfile && pnpm -C website dev",
		"docs:build": "pnpm -C website install --frozen-lockfile && pnpm -C website build",
		"docs:preview": "pnpm docs:build && pnpm -C website preview",
		"docs:diagrams": "pnpm docs:build && node scripts/check-diagrams.mjs"
	},
	"keywords": [
		"Playwright",
		"POM",
		"Page Object Model",
		"Locator",
		"Chaining",
		"Nesting",
		"LocatorSchema",
		"SessionStorage",
		"Test",
		"Test Framework",
		"E2E",
		"End-to-End Testing",
		"Automation",
		"Browser Automation",
		"Web Testing",
		"Logging",
		"Log Levels",
		"TypeScript"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "1.64.0",
		"@types/node": "^24.19.2",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.64.0 <2.0.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@12.14.0"
}
